{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Cost Calculator — provider file",
  "description": "One file per provider in data/providers/<slug>.json. All prices are normalized by the authoring agent (see prompts/add-provider.md).",
  "type": "object",
  "required": ["slug", "provider", "source_url", "last_updated", "models"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "URL-safe id, matches the filename. E.g. 'deepseek' for deepseek.json."
    },
    "provider": { "type": "string", "description": "Human display name. E.g. 'DeepSeek'." },
    "source_url": { "type": "string", "description": "Pricing page the numbers were taken from." },
    "last_updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD of the last price check." },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "provider"],
        "properties": {
          "id": { "type": "string", "description": "Globally unique, kebab-case, prefixed with the slug. E.g. 'deepseek-v4-flash-peak'." },
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["pay_as_you_go", "credit_subscription", "fixed_quota_subscription", "hybrid_monetary_subscription"]
          },
          "provider": { "type": "string", "description": "Must match the file's provider display name." },
          "currency": { "type": "string", "enum": ["USD", "CNY"] },
          "note": { "type": "string" },
          "pricing_per_1m": {
            "type": "object",
            "required": ["cache_hit", "cache_miss", "output"],
            "properties": {
              "cache_hit": { "type": "number", "minimum": 0 },
              "cache_miss": { "type": "number", "minimum": 0 },
              "output": { "type": "number", "minimum": 0 }
            },
            "description": "Price in the stated currency per 1M tokens. cache_miss = plain input price. If the vendor has no cache-hit discount, set cache_hit equal to cache_miss."
          },
          "daily_free_tokens": { "type": "number", "minimum": 0 },
          "model_type": {
            "type": "string",
            "enum": ["chat", "reasoning", "vision", "multimodal", "audio", "image-gen"],
            "description": "Capability label. Priority: image-gen > audio > reasoning > vision > multimodal > chat. Best sourced from the OpenRouter API (see prompts/add-provider.md)."
          },
          "context_length": { "type": "integer", "minimum": 0, "description": "Max context window in tokens (OpenRouter: context_length)." },
          "params_b": { "type": ["number", "null"], "minimum": 0, "description": "Parameter count in billions, parsed from the model slug (e.g. qwen3-30b → 30). Null when unknown." },
          "input_modalities": { "type": "array", "items": { "type": "string" }, "description": "E.g. ['text','image']. OpenRouter: input_modalities." },
          "output_modalities": { "type": "array", "items": { "type": "string" }, "description": "E.g. ['text']. OpenRouter: output_modalities." },
          "supports_reasoning": { "type": "boolean" },
          "or_slug": { "type": "string", "description": "OpenRouter slug (author/name) this entry's metadata was synced from. Used for future refreshes." },
          "promo": {
            "type": "object",
            "description": "Active promotion. Either discount_pct (0-100, scales all prices) or pricing_per_1m (explicit promo rates, pay_as_you_go/hybrid only — wins if both set). Past ends_at disables it.",
            "properties": {
              "discount_pct": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100 },
              "pricing_per_1m": {
                "type": "object",
                "required": ["cache_hit", "cache_miss", "output"],
                "properties": {
                  "cache_hit": { "type": "number", "minimum": 0 },
                  "cache_miss": { "type": "number", "minimum": 0 },
                  "output": { "type": "number", "minimum": 0 }
                }
              },
              "ends_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Promo expiry (YYYY-MM-DD). Omit for open-ended promos." },
              "label": { "type": "string", "description": "Short hover label, e.g. '−75%'. Auto-derived when omitted." }
            }
          },
          "credit_multipliers": {
            "type": "object",
            "required": ["cache_hit", "cache_miss", "output"],
            "properties": {
              "cache_hit": { "type": "number" },
              "cache_miss": { "type": "number" },
              "output": { "type": "number" }
            }
          },
          "credit_formula_divisor": { "type": "number", "exclusiveMinimum": 0 },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "price_usd", "credits"],
              "properties": {
                "name": { "type": "string" },
                "price_usd": { "type": "number", "minimum": 0 },
                "credits": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          },
          "price_usd": { "type": "number", "minimum": 0 },
          "tier_name": { "type": "string" },
          "monthly_token_quota": { "type": "number", "exclusiveMinimum": 0 },
          "subscription_price_usd": { "type": "number", "minimum": 0 },
          "included_dollars": { "type": "number", "minimum": 0 }
        },
        "allOf": [
          { "if": { "properties": { "type": { "const": "pay_as_you_go" } } }, "then": { "required": ["currency", "pricing_per_1m"] } },
          { "if": { "properties": { "type": { "const": "credit_subscription" } } }, "then": { "required": ["credit_multipliers", "tiers"] } },
          { "if": { "properties": { "type": { "const": "fixed_quota_subscription" } } }, "then": { "required": ["price_usd", "monthly_token_quota"] } },
          { "if": { "properties": { "type": { "const": "hybrid_monetary_subscription" } } }, "then": { "required": ["subscription_price_usd", "included_dollars", "pricing_per_1m"] } }
        ]
      }
    }
  }
}
